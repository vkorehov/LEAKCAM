+// Support blockers/enforcers of an object (its volumes of those types), boxes in plate mm.
+static nlohmann::json support_volumes_json(const ModelObject *mo)
+{
+    nlohmann::json a = nlohmann::json::array();
+    if (mo->instances.empty()) return a;
+    const Transform3d inst = mo->instances.front()->get_matrix();
+    for (size_t i = 0; i < mo->volumes.size(); ++i) {
+        const ModelVolume *v = mo->volumes[i];
+        if (!v->is_support_modifier()) continue;
+        const BoundingBoxf3 bb = v->mesh().transformed_bounding_box(inst * v->get_matrix());
+        a.push_back({{"index", i}, {"type", v->is_support_blocker() ? "blocker" : "enforcer"}, {"name", v->name},
+                     {"min", {bb.min.x(), bb.min.y(), bb.min.z()}}, {"max", {bb.max.x(), bb.max.y(), bb.max.z()}}});
+    }
+    return a;
+}
+
+// Modifier volumes of an object: name, settings and box in plate mm.
+static nlohmann::json modifiers_json(const ModelObject *mo)
+{
+    nlohmann::json a = nlohmann::json::array();
+    if (mo->instances.empty()) return a;
+    const Transform3d inst = mo->instances.front()->get_matrix();
+    for (size_t i = 0; i < mo->volumes.size(); ++i) {
+        const ModelVolume *v = mo->volumes[i];
+        if (!v->is_modifier()) continue;
+        const BoundingBoxf3 bb = v->mesh().transformed_bounding_box(inst * v->get_matrix());
+        nlohmann::json cfg = nlohmann::json::object();
+        const DynamicPrintConfig vc = v->config.get();
+        for (const std::string &k : vc.keys()) cfg[k] = vc.opt_serialize(k);
+        a.push_back({{"index", i}, {"name", v->name}, {"config", cfg},
+                     {"min", {bb.min.x(), bb.min.y(), bb.min.z()}}, {"max", {bb.max.x(), bb.max.y(), bb.max.z()}}});
+    }
+    return a;
+}
