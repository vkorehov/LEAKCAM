+// GET /api/v1/plate/custom_gcode -> {"plate": i, "items": [{"print_z", "type", ...}]}
+Response Controller::handle_get_plate_custom_gcode()
+{
+    nlohmann::json r = run_on_ui([]() -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        return {{"plate", plater->get_partplate_list().get_curr_plate_index()},
+                {"items", plate_custom_gcode_json(plater->model())}};
+    });
+    return { 200, r };
+}
