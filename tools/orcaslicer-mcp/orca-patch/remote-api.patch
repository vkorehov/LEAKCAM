+// Layer G-code markers of the current plate: the same list the preview's layer
+// slider edits ("Add custom G-code", "Add pause"), stored in the project.
+static nlohmann::json plate_custom_gcode_json(const Model &model)
+{
+    nlohmann::json a = nlohmann::json::array();
+    for (const auto &it : model.get_curr_plate_custom_gcodes().gcodes) {
+        nlohmann::json o = {{"print_z", it.print_z}};
+        switch (it.type) {
+        case CustomGCode::Custom:      o["type"] = "custom"; o["gcode"] = it.extra; break;
+        case CustomGCode::PausePrint:  o["type"] = "pause";  o["message"] = it.extra; break;
+        case CustomGCode::ColorChange: o["type"] = "color_change"; o["color"] = it.color; break;
+        case CustomGCode::ToolChange:  o["type"] = "tool_change"; o["extruder"] = it.extruder; break;
+        case CustomGCode::Template:    o["type"] = "template"; break;
+        default:                       o["type"] = "unknown"; break;
+        }
+        a.push_back(o);
+    }
+    return a;
+}
