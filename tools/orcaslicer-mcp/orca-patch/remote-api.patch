+// PUT /api/v1/plate/custom_gcode
+//   body {"items": [{"print_z": z, "type": "custom", "gcode": "M104 S220"}
+//                 | {"print_z": z, "type": "pause", "message": "..."}]}
+//   Replaces the current plate's markers; an empty list clears them.
+Response Controller::handle_put_plate_custom_gcode(const std::string &body)
+{
+    nlohmann::json in = nlohmann::json::parse(body);
+    if (!in.is_object() || !in.contains("items") || !in["items"].is_array())
+        return { 400, {{"error", "missing_fields"}, {"detail", "items: array"}} };
+    std::vector<CustomGCode::Item> items;
+    for (const auto &j : in["items"]) {
+        if (!j.is_object() || !j.contains("print_z") || !j["print_z"].is_number())
+            return { 400, {{"error", "bad_item"}, {"detail", "each item needs a numeric print_z"}} };
+        CustomGCode::Item it;
+        it.print_z  = j["print_z"].get<double>();
+        it.extruder = 1;
+        std::string type = j.value("type", "custom");
+        if (!(it.print_z > 0.0))
+            return { 400, {{"error", "bad_item"}, {"detail", "print_z must be > 0"}} };
+        if (type == "custom") {
+            if (!j.contains("gcode") || !j["gcode"].is_string() || j["gcode"].get<std::string>().empty())
+                return { 400, {{"error", "bad_item"}, {"detail", "custom needs non-empty gcode"}} };
+            it.type  = CustomGCode::Custom;
+            it.extra = j["gcode"].get<std::string>();
+        } else if (type == "pause") {
+            it.type  = CustomGCode::PausePrint;
+            it.extra = j.value("message", std::string());
+        } else
+            return { 400, {{"error", "bad_item"}, {"detail", "type must be custom or pause"}} };
+        items.push_back(it);
+    }
+    std::sort(items.begin(), items.end());
+    for (size_t i = 1; i < items.size(); ++i)
+        if (std::abs(items[i].print_z - items[i - 1].print_z) < EPSILON)
+            return { 400, {{"error", "duplicate_print_z"}, {"print_z", items[i].print_z}} };
+
+    // Custom markers put raw G-code into the print: the same policy as the *_gcode config keys.
+    bool has_custom = std::any_of(items.begin(), items.end(),
+                                  [](const CustomGCode::Item &it) { return it.type == CustomGCode::Custom; });
+    if (has_custom && !run_on_ui([]() -> nlohmann::json { return sensitive_writes_allowed(); }).get<bool>())
+        return { 403, {{"error", "blocked_by_remote_api_policy"},
+                       {"detail", "custom G-code markers need 'allow sensitive' in the Remote API preferences"}} };
+
+    nlohmann::json r = run_on_ui([items]() -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        Model  &model  = plater->model();
+        int plate_idx = plater->get_partplate_list().get_curr_plate_index();
+        CustomGCode::Info &info = model.plates_custom_gcodes[plate_idx];
+        info.gcodes = items;
+        if (info.mode == CustomGCode::Undef)
+            info.mode = CustomGCode::SingleExtruder;
+        // Same follow-up as the slider's tick change: the plate's G-code is stale.
+        if (PartPlate *plate = plater->get_partplate_list().get_curr_plate())
+            plate->update_slice_result_valid_state(false);
+        plater->set_plater_dirty(true);
+        api_notify("Set " + std::to_string(items.size()) + " layer G-code marker(s) on plate " + std::to_string(plate_idx + 1));
+        return {{"plate", plate_idx}, {"items", plate_custom_gcode_json(model)}};
+    });
+    return { 200, r };
+}
