+// POST /api/v1/objects/{id}/support_volume
+//   body {"type":"blocker"|"enforcer","min":[x,y,z],"max":[x,y,z]}: a box in plate mm, the same
+//   volume as the object list's Add support blocker/enforcer -> Box, placed by coordinates
+Response Controller::handle_add_support_volume(uint64_t id, const std::string &body)
+{
+    nlohmann::json in = nlohmann::json::parse(body);
+    if (!in.is_object()) return { 400, {{"error", "body_must_be_object"}} };
+    const std::string type = in.value("type", std::string());
+    if (type != "blocker" && type != "enforcer")
+        return { 400, {{"error", "bad_type"}, {"detail", "type: blocker | enforcer"}} };
+    auto read_vec = [&in](const char *k, Vec3d &out) {
+        if (!in.contains(k) || !in[k].is_array() || in[k].size() != 3) return false;
+        out = Vec3d(in[k][0].get<double>(), in[k][1].get<double>(), in[k][2].get<double>());
+        return true;
+    };
+    Vec3d lo, hi;
+    if (!read_vec("min", lo) || !read_vec("max", hi))
+        return { 400, {{"error", "missing_fields"}, {"detail", "min [x,y,z] and max [x,y,z] in plate mm"}} };
+    if (!((hi - lo).minCoeff() > 0.0))
+        return { 400, {{"error", "bad_box"}, {"detail", "need max > min on every axis"}} };
+
+    nlohmann::json r = run_on_ui([=]() -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        int idx = find_object_index(plater->model(), id);
+        if (idx < 0) { api_notify("Object not found", true); return {{"error", "unknown_object"}}; }
+        ModelObject *mo = plater->model().objects[idx];
+        if (mo->instances.empty()) return {{"error", "no_instance"}};
+        const ModelInstance *mi = mo->instances.front();
+        const bool blocker = type == "blocker";
+        plater->take_snapshot(blocker ? "Add support blocker" : "Add support enforcer");
+        const Vec3d size = hi - lo;
+        ModelVolume *nv = mo->add_volume(TriangleMesh(its_make_cube(size.x(), size.y(), size.z())),
+                                         blocker ? ModelVolumeType::SUPPORT_BLOCKER : ModelVolumeType::SUPPORT_ENFORCER);
+        // As ObjectList::load_generic_subobject: aligned with the bed (the instance's rotation and
+        // scale undone), then its centre put on the box centre instead of the bounding-box corner.
+        const Transform3d inv = mi->get_transformation().get_matrix_no_offset().inverse();
+        nv->set_transformation(inv);
+        nv->set_offset(inv * (0.5 * (lo + hi) - mi->get_offset()));
+        nv->name = blocker ? "Generic-Support Blocker" : "Generic-Support Enforcer";
+        nv->config.set_key_value("extruder", new ConfigOptionInt(0));
+        nv->source.is_from_builtin_objects = true;
+        wxGetApp().obj_list()->reorder_volumes_and_get_selection(idx);
+        plater->get_partplate_list().notify_instance_update(idx, 0);
+        plater->changed_object(idx);
+        api_notify(std::string(blocker ? "Added a support blocker to '" : "Added a support enforcer to '") + mo->name + "'");
+        return {{"id", id}, {"support_volumes", support_volumes_json(mo)}};
+    });
+    if (r.contains("error"))
+        return { r["error"] == "unknown_object" ? 404 : 422, r };
+    return { 200, r };
+}
+
+// DELETE /api/v1/objects/{id}/support_volume[?type=blocker|enforcer]: remove them (all by default)
+Response Controller::handle_delete_support_volumes(uint64_t id, const std::string &type)
+{
+    if (!type.empty() && type != "blocker" && type != "enforcer")
+        return { 400, {{"error", "bad_type"}, {"detail", "type: blocker | enforcer (or none for both)"}} };
+    nlohmann::json r = run_on_ui([=]() -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        int idx = find_object_index(plater->model(), id);
+        if (idx < 0) { api_notify("Object not found", true); return {{"error", "unknown_object"}}; }
+        ModelObject *mo = plater->model().objects[idx];
+        std::vector<size_t> doomed;
+        for (size_t i = 0; i < mo->volumes.size(); ++i) {
+            const ModelVolume *v = mo->volumes[i];
+            if (v->is_support_modifier() && (type.empty() || (type == "blocker") == v->is_support_blocker()))
+                doomed.push_back(i);
+        }
+        if (!doomed.empty()) {
+            plater->take_snapshot("Delete support volumes");
+            for (auto it = doomed.rbegin(); it != doomed.rend(); ++it)
+                mo->delete_volume(*it);
+            wxGetApp().obj_list()->reorder_volumes_and_get_selection(idx);
+            plater->get_partplate_list().notify_instance_update(idx, 0);
+            plater->changed_object(idx);
+            api_notify("Removed " + std::to_string(doomed.size()) + " support volume(s) from '" + mo->name + "'");
+        }
+        return {{"id", id}, {"deleted", doomed.size()}, {"support_volumes", support_volumes_json(mo)}};
+    });
+    if (r.contains("error")) return { 404, r };
+    return { 200, r };
+}
+
+// POST /api/v1/objects/{id}/modifier
+//   body {"mesh_path": "C:\\...\\x.stl", "config": {"fuzzy_skin": "none", ...}, "name": "..."}
+//   The mesh (STL, coordinates in plate mm) becomes a modifier volume of the object with those
+//   settings, as the object list's Add modifier -> Load, but placed where the file says.
+Response Controller::handle_add_modifier(uint64_t id, const std::string &body)
+{
+    nlohmann::json in = nlohmann::json::parse(body);
+    if (!in.is_object() || !in.contains("mesh_path") || !in["mesh_path"].is_string())
+        return { 400, {{"error", "missing_fields"}, {"detail", "mesh_path (STL in plate mm), config {key: value}"}} };
+    if (!in.contains("config") || !in["config"].is_object() || in["config"].empty())
+        return { 400, {{"error", "missing_fields"}, {"detail", "config: the modifier's settings, at least one"}} };
+    const std::string path = in["mesh_path"].get<std::string>();
+    const std::string name = in.value("name", std::string("Modifier"));
+    const nlohmann::json changes = in["config"];
+
+    Model loaded;
+    if (!load_stl(path.c_str(), &loaded) || loaded.objects.empty() || loaded.objects.front()->volumes.empty())
+        return { 422, {{"error", "mesh_not_loaded"}, {"detail", path}} };
+    TriangleMesh mesh = loaded.objects.front()->volumes.front()->mesh();
+    if (mesh.empty())
+        return { 422, {{"error", "mesh_empty"}, {"detail", path}} };
+
+    nlohmann::json r = run_on_ui([id, name, changes, mesh]() mutable -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        int idx = find_object_index(plater->model(), id);
+        if (idx < 0) { api_notify("Object not found", true); return {{"error", "unknown_object"}}; }
+        ModelObject *mo = plater->model().objects[idx];
+        if (mo->instances.empty()) return {{"error", "no_instance"}};
+        // The settings first: an unknown or refused key adds nothing (same rules as PUT /objects/{id}/config).
+        DynamicPrintConfig cfg;
+        nlohmann::json errors = nlohmann::json::object();
+        const bool allow_sensitive = sensitive_writes_allowed();
+        for (auto it = changes.begin(); it != changes.end(); ++it) {
+            const std::string &key = it.key();
+            if (print_config_def.get(key) == nullptr) { errors[key] = "unknown_key"; continue; }
+            if (!allow_sensitive && is_sensitive_config_key(key)) { errors[key] = "blocked_by_remote_api_policy"; continue; }
+            try { cfg.set_deserialize_strict(key, json_value_to_config_string(it.value())); }
+            catch (const std::exception &e) { errors[key] = e.what(); }
+        }
+        if (!errors.empty()) return {{"error", "bad_config"}, {"errors", errors}};
+        plater->take_snapshot("Add modifier");
+        // Kept as loaded (no centring), under the inverse instance matrix: world = file coordinates.
+        ModelVolume *nv = mo->add_volume(std::move(mesh), ModelVolumeType::PARAMETER_MODIFIER, false);
+        nv->set_transformation(mo->instances.front()->get_matrix().inverse());
+        nv->name = name;
+        cfg.set_key_value("extruder", new ConfigOptionInt(0));
+        nv->config.assign_config(std::move(cfg));
+        wxGetApp().obj_list()->reorder_volumes_and_get_selection(idx);
+        plater->get_partplate_list().notify_instance_update(idx, 0);
+        plater->changed_object(idx);
+        api_notify("Added modifier '" + name + "' to '" + mo->name + "'");
+        return {{"id", id}, {"modifiers", modifiers_json(mo)}};
+    });
+    if (r.contains("error"))
+        return { r["error"] == "unknown_object" ? 404 : 422, r };
+    return { 200, r };
+}
+
+// DELETE /api/v1/objects/{id}/modifier[?name=...]: remove the object's modifiers (all, or by name)
+Response Controller::handle_delete_modifiers(uint64_t id, const std::string &name)
+{
+    nlohmann::json r = run_on_ui([=]() -> nlohmann::json {
+        Plater *plater = wxGetApp().plater();
+        int idx = find_object_index(plater->model(), id);
+        if (idx < 0) { api_notify("Object not found", true); return {{"error", "unknown_object"}}; }
+        ModelObject *mo = plater->model().objects[idx];
+        std::vector<size_t> doomed;
+        for (size_t i = 0; i < mo->volumes.size(); ++i)
+            if (mo->volumes[i]->is_modifier() && (name.empty() || mo->volumes[i]->name == name))
+                doomed.push_back(i);
+        if (!doomed.empty()) {
+            plater->take_snapshot("Delete modifiers");
+            for (auto it = doomed.rbegin(); it != doomed.rend(); ++it)
+                mo->delete_volume(*it);
+            wxGetApp().obj_list()->reorder_volumes_and_get_selection(idx);
+            plater->get_partplate_list().notify_instance_update(idx, 0);
+            plater->changed_object(idx);
+            api_notify("Removed " + std::to_string(doomed.size()) + " modifier(s) from '" + mo->name + "'");
+        }
+        return {{"id", id}, {"deleted", doomed.size()}, {"modifiers", modifiers_json(mo)}};
+    });
+    if (r.contains("error")) return { 404, r };
+    return { 200, r };
+}
