# LEAKCAM BL616 power-up test: FreeRTOS + SDK shell on the USB CDC console (PR1). Wi-Fi for pt_wifi (test100), BLE for pt_ble (test040).
# The USB console needs FreeRTOS, the shell and CherryUSB's CDC-ACM class; without any of them
# Kconfig drops CONFIG_BSP_CONSOLE_USB_CDC silently and the console falls back to UART0 = the
# K230 link pins (check build/generated/autoconfig.h).
CONFIG_FREERTOS                 =y
CONFIG_SHELL                    =y
CONFIG_CHERRYUSB                =y
CONFIG_CHERRYUSB_OSAL           ="freertos"
CONFIG_CHERRYUSB_DEVICE         =y
CONFIG_CHERRYUSB_DEVICE_CDC     =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM =y
CONFIG_BSP_CONSOLE_USB_CDC      =y

# pt_time (test021): easyflash on littlefs in the PSM partition, as the product keeps its Wi-Fi credentials
CONFIG_LITTLEFS                 =y
CONFIG_LITTLEFS_KV_EASYFLASH    =y
CONFIG_BFLB_MTD                 =y
CONFIG_PARTITION                =y

# pt_wifi (test100 step 1): the SDK's Wi-Fi set (lwIP, RF, Wi-Fi 6 fhost), as the product; ping kept for the tests
-include $(BL_SDK_BASE)/examples/wifi/defconfig
CONFIG_IPV6 =n

# pt_wifi bridge (test100 step 2): the product's NetHub over SDIO (firmware/bl616/defconfig)
CONFIG_BSP_MR              =y
CONFIG_MR_NETDEV           =y
CONFIG_MR_SDIO_DRIVER      =y
CONFIG_MR_SDIO_QUEUE_DEPTH =4
CONFIG_MR_TTY              =n
CONFIG_MR_VIRTUALCHAN      =y
CONFIG_NETHUB_CTRLCHANNEL_USE_ATMODULE =n
CONFIG_NETHUB_LOWPOWER_ENABLE          =n
CONFIG_NETHUB_PROFILE_DUAL             =n
CONFIG_NETHUB_PROFILE_SDIO             =y
CONFIG_NETHUB_PROFILE_USB              =n
CONFIG_NETHUB                          =y

# mem_stat.c (`mem`): the lowest free heap since boot, a memory metric of every test
CONFIG_MM_ENABLE_MIN_FREE_TRACKING=y

# pt_ble (test040): the product's BLE provisioning (firmware/bl616/defconfig): peripheral, no BLE shell commands
CONFIG_BLUETOOTH              =y
CONFIG_BTBLECONTROLLER_LIB    =ble1m0s1bredr0
CONFIG_BT_STACK_CLI           =n

