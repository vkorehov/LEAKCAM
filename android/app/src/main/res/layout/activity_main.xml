<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- the app's menu (the screens: LEAKCAMs, Setup) and the screen's name: "LEAKCAMs" on the status screen,
             "LEAKCAM setup" on the setup screen (user 2026-11-07) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nav_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="@null"
                android:contentDescription="@string/nav_menu"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/mine_title"
                android:textAppearance="@android:style/TextAppearance.Material.Headline" />
        </LinearLayout>


        <!-- the status screen (use case 2): the LEAKCAMs set up from this phone, online or offline as the presence
             server sees them; setup opens only for a LEAKCAM on USB power (it advertises only then) -->
        <LinearLayout
            android:id="@+id/status_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- a leak, opened from its alert (DESIGN.md 5.3.13): which board, when, what found it, and its record (4
                 pictures, a 15 s video) as the board uploads it -->
            <LinearLayout
                android:id="@+id/leak_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/leak_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/leak_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@android:style/TextAppearance.Material.Title"
                    android:textColor="@color/leak_text" />

                <TextView
                    android:id="@+id/leak_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/leak_text" />

                <!-- the leak's record (DESIGN.md 5.3.13): one preview, the first picture downloaded into the phone's
                     gallery (a spinner until then), "+N more" for the rest; a tap opens the whole LEAKCAM album
                     (user 2026-11-07) -->
                <FrameLayout
                    android:id="@+id/leak_preview"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/tile"
                    android:clipToOutline="true">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/leak_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="#FFFFFFFF"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- a false alarm: the check re-armed (DESIGN.md 5.3.13, user 2026-11-07) -->
                <Button
                    android:id="@+id/leak_not"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/not_leak" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mine_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />


            <!-- the picked board's actions: Take photo / Take video; the rare ones (Change Wi-Fi, Delete, Set up a new
                 LEAKCAM) behind the three dots at the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- the common actions (DESIGN.md 5.3.14) -->
                <Button
                    android:id="@+id/take_photo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/take_photo" />

                <Button
                    android:id="@+id/take_video"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/take_video" />

                <ImageButton
                    android:id="@+id/more"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="@string/more"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <!-- the status block under the action row (status_block.xml): a longer or shorter message never moves the
                 buttons (user 2026-11-07: no jumps in the action area) -->
            <include
                android:id="@+id/main_status"
                layout="@layout/status_block" />

            <!-- what waits for the picked board's check-ins, from the server (user 2026-11-07): under everything, so it
                 moves nothing when it comes and goes -->
            <TextView
                android:id="@+id/pending_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="12dp"
                android:visibility="gone" />

            <!-- the picked board's photos and videos on the server, newest first, each a link that opens it alone in
                 the phone's viewer or player (user 2026-11-07) -->
            <LinearLayout
                android:id="@+id/media_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- setup: a new LEAKCAM in four steps, or a known one's Wi-Fi changed; it keeps looking over Bluetooth and on
             the cable at once (user 2026-11-07) -->
        <LinearLayout
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro" />

        <!-- the steps; MainActivity marks the current one -->
        <TextView
            android:id="@+id/step1"
            style="@style/Step"
            android:text="@string/step1" />

        <TextView
            android:id="@+id/step2"
            style="@style/Step"
            android:text="@string/step2" />

        <TextView
            android:id="@+id/step3"
            style="@style/Step"
            android:text="@string/step3" />

        <TextView
            android:id="@+id/step4"
            style="@style/Step"
            android:text="@string/step4" />


        <EditText
            android:id="@+id/ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/ssid"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/show_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_password" />

        <!-- the action row as on the status screen: Send, and its rare action behind the three dots (Save without
             checking after a check that may have failed only because of where the LEAKCAM is now); nothing here comes
             and goes (user 2026-11-07: no jumps in the action area) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/send" />

            <ImageButton
                android:id="@+id/setup_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- the status block under the action row (status_block.xml): looking, sending and what to do now -->
        <include
            android:id="@+id/setup_status"
            layout="@layout/status_block" />

        <!-- the boards found: under the status block, so a board found or gone moves nothing above it (user
             2026-11-07: no jumping buttons) -->
        <RadioGroup
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
