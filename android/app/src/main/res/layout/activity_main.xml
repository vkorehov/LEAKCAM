<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />


        <!-- the status screen (use case 2): the LEAKCAMs set up from this phone, online or offline as the presence
             server sees them; setup opens only for a LEAKCAM on USB power (it advertises only then) -->
        <LinearLayout
            android:id="@+id/status_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- a leak, opened from its alert (DESIGN.md 5.3.13): which board, when, what found it, and its record (4
                 pictures, a 15 s video) as the board uploads it -->
            <LinearLayout
                android:id="@+id/leak_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/leak_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/leak_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@android:style/TextAppearance.Material.Title"
                    android:textColor="@color/leak_text" />

                <TextView
                    android:id="@+id/leak_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/leak_text" />

                <!-- the leak's record (DESIGN.md 5.3.13): one preview, the first picture downloaded into the phone's
                     gallery (a spinner until then), "+N more" for the rest; a tap opens the whole LEAKCAM album
                     (user 2026-11-07) -->
                <FrameLayout
                    android:id="@+id/leak_preview"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/tile"
                    android:clipToOutline="true">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/leak_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="#FFFFFFFF"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mine_title"
                android:textAppearance="@android:style/TextAppearance.Material.Title" />

            <LinearLayout
                android:id="@+id/mine_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- the list keeps looking (no Find button, user 2026-11-07): always here, so nothing moves -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/looking"
                    android:textColor="#FF757575" />
            </LinearLayout>

            <!-- the picked board's actions: Set up (a new board) or Take photo / Take video (one of mine); the rare ones
                 (Change Wi-Fi, Delete) behind the three dots at the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/setup_open"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:enabled="false"
                    android:maxLines="1"
                    android:text="@string/setup_new" />

                <!-- one of the person's boards: its common actions (DESIGN.md 5.3.14); in place of setup_open -->
                <Button
                    android:id="@+id/take_photo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/take_photo"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/take_video"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/take_video"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/more"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="@string/more"
                    android:src="@drawable/ic_more"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- under the action row: a longer or shorter message never moves the button (user 2026-11-07: no jumps in
                 the action area) -->
            <TextView
                android:id="@+id/nearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/help_background"
                android:padding="12dp"
                android:text="@string/nearby_none" />
        </LinearLayout>

        <!-- setup: a new LEAKCAM in four steps, or a known one's Wi-Fi changed -->
        <LinearLayout
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- the cable flow's own header: the board is found by the plug, no list (user 2026-11-05) -->
        <TextView
            android:id="@+id/usb_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_usb"
            android:gravity="center_vertical"
            android:textAppearance="@android:style/TextAppearance.Material.Title"
            android:visibility="gone" />

        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro" />

        <!-- the steps; MainActivity marks the current one -->
        <TextView
            android:id="@+id/step1"
            style="@style/Step"
            android:text="@string/step1" />

        <TextView
            android:id="@+id/step2"
            style="@style/Step"
            android:text="@string/step2" />

        <TextView
            android:id="@+id/step3"
            style="@style/Step"
            android:text="@string/step3" />

        <TextView
            android:id="@+id/step4"
            style="@style/Step"
            android:text="@string/step4" />

        <RadioGroup
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/ssid"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/show_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_password" />

        <!-- the action row as on the status screen: Send, and its rare actions behind the three dots (Save without
             checking after a check that may have failed only because of where the LEAKCAM is now; back to your
             LEAKCAMs); nothing here comes and goes (user 2026-11-07: no jumps in the action area) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/send" />

            <ImageButton
                android:id="@+id/setup_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- what to do now: under the action row, so a long message never moves the controls -->
        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/help_background"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
