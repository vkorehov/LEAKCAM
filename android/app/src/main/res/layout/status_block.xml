<?xml version="1.0" encoding="utf-8"?>
<!-- the status block (DESIGN.md 5.3.4, a building block of every screen, user 2026-11-07): right under the screen's
     action row, so nothing it says moves the buttons. A spinner line for what happens now (looking, sending; gone when
     nothing runs), then the message: what to do, what happened (red background for a problem). StatusBlock.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@color/help_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/busy_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/busy_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FF757575" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />
</LinearLayout>
