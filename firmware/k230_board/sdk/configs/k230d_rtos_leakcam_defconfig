CONFIG_BOARD_CONFIG_NAME="k230d_rtos_leakcam_defconfig"
CONFIG_BOARD_K230D_LEAKCAM=y
CONFIG_BOARD_NAME="LEAKCAM_K230D"
CONFIG_BOARD_GEN_IMAGE_CFG_FILE="genimage-spinand.cfg"
# SPL/U-Boot built from source with the LEAKCAM device tree: the prebuilt EVB SPI-NAND binaries
# set most IO banks to 1.8 V mode, and every bank is 3.3 V on this board
# CONFIG_UBOOT_USE_PREBUILT is not set
CONFIG_UBOOT_CONFIG_FILE="k230d_leakcam"
CONFIG_RTSMART_CONFIG_FILE="k230d_leakcam"
# the BL616 link agent, started at boot by msh; no fast-boot preload (it expects a MicroPython or
# rtapp image)
CONFIG_RTT_AUTO_EXEC_CMD="/app/leakcam &"
# CONFIG_FAST_BOOT_CONFIGURATION is not set
# OpenSBI built from source (no prebuilt board blobs)
# CONFIG_OPENSBI_USE_PREBUILT_FW_JUMP is not set
# cameras: CAM2 (J4) on CSI0 + i2c0 (IO48/49), CAM1 (J5) on CSI2 + i2c4 (IO7/8), OV5647 on
# Pi-v1.3-style boards with their own 25 MHz oscillator (no chip MCLK); connector pin 18 is the
# module's LED line, not a reset, so no reset or power-down GPIO
CONFIG_MPP_ENABLE_CSI_DEV_0=y
CONFIG_MPP_CSI_DEV0_POWER=-1
CONFIG_MPP_CSI_DEV0_RESET=-1
CONFIG_MPP_CSI_DEV0_I2C_DEV="i2c0"
CONFIG_MPP_CSI_DEV0_MCLK_INVALID=y
CONFIG_MPP_ENABLE_CSI_DEV_2=y
CONFIG_MPP_CSI_DEV2_POWER=-1
CONFIG_MPP_CSI_DEV2_RESET=-1
CONFIG_MPP_CSI_DEV2_I2C_DEV="i2c4"
CONFIG_MPP_CSI_DEV2_MCLK_INVALID=y
CONFIG_MPP_ENABLE_SENSOR_OV5647=y
CONFIG_APP_ENABLE_LEAKCAM=y
# networking comes from the BL616 over SDIO, not USB LAN
# CONFIG_ENABLE_NETWORK_RT_LAN_OVER_USB is not set

# --- LEAKCAM minimal image (tests/test008, 2026-10-22): inherited from the CanMV board, unused here
# CONFIG_MPP_ENABLE_MIDDLEWARE_LIB_FFMPEG is not set
# CONFIG_MPP_DSI_ENABLE_VIRT is not set
# console on UART1 at the link's one rate (link_mux; the BL616 shows it on /dev/ttyACM1), 2026-10-22
CONFIG_RTT_CONSOLE_UART1=y
CONFIG_RTT_CONSOLE_ID=1
CONFIG_RTT_CONSOLE_BAUD=2000000
# memory split of the 128 MB DDR (2026-11-12, native camera frames and video): RT-Smart 52 MB, the media pool (MMZ)
# 76 MB. MMZ: two cameras at 2592x1944, 2 raw (10.1 MB) + 2 NV12 (7.6 MB) buffers each = 69.9 MB (/proc/media-mem),
# the JPEG encoder's 2 x 1.25 MB stream buffers, or during a video (the JPEG channel closed) the two H.265 channels'
# 3 x 0.63 MB each. RT-Smart: one native H.265 channel takes ~14 MB of pages (list_page during a video), two need
# ~28 MB; at 48 MB 27.8 were free (the history buffer allocated per check only). RT-Smart: the kernel heap 8 MB (the camera pipelines take ~6.8) and the page allocator, from
# which the video encoder takes its page tables and working pages: at 32 MB it had 2.9 MB free and a native JPEG
# failed "mvx_mmu_alloc_page: fail". The frames are read in their video buffers, no copies in RT-Smart.
# (1280x960 before: 58 / 70 MB)
CONFIG_MEM_RTSMART_SIZE=0x3400000
CONFIG_MEM_MMZ_BASE=0x3400000
CONFIG_MEM_MMZ_SIZE=0x4C00000
