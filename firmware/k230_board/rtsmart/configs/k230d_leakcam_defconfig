# LEAKCAM RT-Smart kernel config (bsp/maix3/configs/k230d_leakcam_defconfig).
# Base: k230d_canmv_bpi_zero_defconfig (same K230D SiP, OV5647 on CSI0/CSI2), cut to what LEAKCAM
# uses for the lightest runtime and fastest boot: UART, I2C0/I2C4, PWM, GPIO, SPI0 (NAND) + UFFS,
# watchdog, DMA, soft RTC, romfs/tmpfs/procfs, the MPP camera stack, and networking over the BL616
# (SDIO host on MMC0, RT-Thread WLAN framework, lwIP, SAL sockets, NTP). Removed: touch, WS2812,
# one-wire, Realtek Wi-Fi, USB device, FAT, crypto engines, FFT, hardware timers, soft I2C,
# I2C1-3, SPI1-2, regulators, fast-boot preload.
CONFIG_RT_NAME_MAX=20
CONFIG_RT_USING_SMART=y
CONFIG_RT_ALIGN_SIZE=64
CONFIG_RT_TICK_PER_SECOND=1000
CONFIG_IDLE_THREAD_STACK_SIZE=16384
CONFIG_RT_TIMER_THREAD_STACK_SIZE=16384
CONFIG_RT_USING_SIGNALS=y
CONFIG_RT_USING_MEMHEAP=y
CONFIG_RT_USING_MEMHEAP_AS_HEAP=y
CONFIG_RT_USING_DEVICE_OPS=y
CONFIG_RT_CONSOLEBUF_SIZE=256
CONFIG_RT_CONSOLE_DEVICE_NAME="uart0"
CONFIG_RT_USING_USERSPACE=y
CONFIG_KERNEL_VADDR_START=0x150000000
CONFIG_RT_MAIN_THREAD_STACK_SIZE=16384
CONFIG_FINSH_THREAD_STACK_SIZE=81920
CONFIG_FINSH_CMD_SIZE=1024
CONFIG_FINSH_ARG_MAX=100
CONFIG_MSH_WAIT_LWP_FINISH=y
CONFIG_DFS_FILESYSTEMS_MAX=16
CONFIG_DFS_FILESYSTEM_TYPES_MAX=6
CONFIG_DFS_FD_MAX=128
CONFIG_RT_USING_DFS_ROMFS=y
CONFIG_RT_USING_DFS_TMPFS=y
CONFIG_RT_USING_DFS_PROCFS=y
CONFIG_RT_SYSTEM_WORKQUEUE_STACKSIZE=20480
CONFIG_RT_SYSTEM_WORKQUEUE_PRIORITY=17
CONFIG_RT_SERIAL_USING_DMA=y
CONFIG_RT_USING_CPUTIME=y
CONFIG_RT_USING_I2C=y
CONFIG_RT_USING_DEVMEM=y
CONFIG_RT_USING_PWM=y
CONFIG_RT_USING_PM=y
CONFIG_RT_USING_SPI=y
CONFIG_RT_USING_QSPI=y
CONFIG_RT_USING_WDT=y
# ADC: audio codec (MEMS mic U13) and its detection; TS: die temperature for the power manager
CONFIG_RT_USING_ADC=y
CONFIG_RT_USING_TS=y
CONFIG_DRV_TS_USE_RT_DEVICE=y
# --- networking through the BL616 (SDIO slave on MMC0)
CONFIG_RT_USING_SDIO=y
CONFIG_RT_SDIO_STACK_SIZE=10240
CONFIG_RT_SDIO_THREAD_PRIORITY=4
CONFIG_RT_MMCSD_STACK_SIZE=32768
CONFIG_RT_USING_SDIO0=y
# BL616 NetHub Wi-Fi driver (drivers/extdrv/bl616_nethub, installed by install.sh). The BL616 is
# wired to MMC0 with CLK, CMD and D0-D3 only (bl616_pwrmgr/board_pins.h); its CHIP_EN is not the
# K230's to pulse, so the board glue must not toggle the SDIO0 reset output before probing.
CONFIG_RT_USING_BL616_NETHUB=y
# CONFIG_BSP_WIFI_SDIO_USE_SDIO0_RESET is not set
CONFIG_RT_USING_WIFI=y
CONFIG_RT_WLAN_DEVICE_STA_NAME="sta"
CONFIG_RT_WLAN_DEVICE_AP_NAME="ap"
CONFIG_SAL_USING_POSIX=y
CONFIG_SAL_USING_AF_UNIX=y
CONFIG_RT_USING_LWIP212=y
CONFIG_RT_LWIP_MEM_ALIGNMENT=8
CONFIG_PKG_USING_NETUTILS=y
CONFIG_PKG_NETUTILS_NTP=y
CONFIG_RT_BOARD_CHIP_K230D=y
CONFIG_RT_USING_GPIO=y
CONFIG_RT_USING_I2C0=y
CONFIG_RT_USING_I2C4=y
CONFIG_RT_USING_PDMA=y
CONFIG_RT_USING_SPI0=y
CONFIG___STACKSIZE__=65536
# --- LEAKCAM: boot and filesystems on the W25N02KV SPI NAND (as k230_evb_spinand_defconfig)
CONFIG_RT_BOARD_ENABLE_PINMUX=y
CONFIG_LPKG_USING_SPINAND=y
CONFIG_SPI_NAND_ON_OSPI=y
CONFIG_SPI_NAND_SPI_BUS_WIDTH_4=y
CONFIG_SPI_NAND_SPI_FREQ=50000000
CONFIG_SPI_NAND_WINBOND=y
CONFIG_RT_SPI0_RXSD=6
CONFIG_RT_USING_DFS_UFFS=y
CONFIG_RT_UFFS_ECC_MODE_3=y
# --- LEAKCAM: the K230's RTC loses power with the K230; the time comes from the BL616 (TIME frame)
CONFIG_RT_USING_SOFT_RTC=y
