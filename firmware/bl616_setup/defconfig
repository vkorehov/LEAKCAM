# LEAKCAM BL616 setup firmware (DESIGN.md 5.3.1): BLE advertising while the chip sleeps in PDS, the Wi-Fi credential
# check, the USB plug wake. Only what setup mode needs (user, 2026-11-01). From the SDK's examples/pmu/wl_ble_lp.

# the board's USB console (PR1): the shell for `isp` (hands-free flashing) and the test commands
CONFIG_SHELL                    =y
CONFIG_CHERRYUSB                =y
CONFIG_CHERRYUSB_OSAL           ="freertos"
CONFIG_CHERRYUSB_DEVICE         =y
CONFIG_CHERRYUSB_DEVICE_CDC     =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM =y
CONFIG_BSP_CONSOLE_USB_CDC      =y
# with CONFIG_LPAPP, board_init() gates every peripheral clock and turns the USB one on only with BSP_USB: without it
# usb_console_init() stalled the CPU on the first USB register (the first build: 45-51 mA, never on USB, test120)
CONFIG_BSP_USB                  =y
# mem_stat.c (`mem`): the lowest free heap since boot, a memory metric of every test
CONFIG_MM_ENABLE_MIN_FREE_TRACKING=y

CONFIG_BFLB_LOG =n
CONFIG_FREERTOS =y
CONFIG_POSIX =n
CONFIG_TLSF =y
# the credential check (wifi_check.c): the BL616's own station, DHCP client, DNS and HTTP; mbedtls for WPA3 (SAE)
CONFIG_LWIP =y
CONFIG_FHOST =y
CONFIG_WIFI6 =y
CONFIG_RF =y
CONFIG_MBEDTLS =y
CONFIG_XZ =y
# not used (no access point), but the SDK's Wi-Fi lwIP adapter (net_al_ext.c) includes dhcp_server.h
CONFIG_DHCPD =y
CONFIG_MBEDTLS_AES_USE_HW =y
CONFIG_MBEDTLS_BIGNUM_USE_HW =y
CONFIG_MBEDTLS_ECC_USE_HW =y
CONFIG_MBEDTLS_SHA1_USE_HW =y
CONFIG_MBEDTLS_SHA256_USE_HW =y
CONFIG_MBEDTLS_SHA512_USE_HW =y

CONFIG_VSNPRINTF_NANO       =n
CONFIG_VSNPRINTF_LONG_LONG  =y

# the low-power firmware (lpfw) appended to the image; PDS between advertisements
CONFIG_LPAPP =y
CONFIG_POST_BUILDS_CONCAT_WITH_LP_FW=y
CONFIG_PM =y
CONFIG_LWIP_LP =y
# accurate tickless depends on TICKLESS_EXT (components/os/Kconfig): the SDK example set only ACCURATE for the BL616
CONFIG_TICKLESS_EXT =y
CONFIG_TICKLESS_ACCURATE =y
CONFIG_DCDC_ENABLE =n
CONFIG_MACSW_SELECT = default
CONFIG_PWRMGMT               =y

# easyflash: the credentials, the pairing PIN, the clock source
CONFIG_LITTLEFS              =y
CONFIG_LITTLEFS_KV_EASYFLASH =y
CONFIG_BFLB_MTD              =y
CONFIG_PARTITION             =y
CONFIG_CLOCK_SOURCE_EF_PARAM =y

# the product's BLE provisioning (firmware/bl616_setup/ble_pairing.c): peripheral, no BLE shell commands, the stored
# pairing PIN as the passkey (bt_passkey_set)
CONFIG_BLUETOOTH =y
CONFIG_BTBLECONTROLLER_LIB =ble1m0s1bredr0
CONFIG_BLE_USE_MAC2 =n
CONFIG_BT_STACK_CLI =n
CONFIG_BT_FIXED_PASSKEY =y

# mTLS for the check-in (tls_link.c; the full firmware's defconfig says why): TLS 1.3 + 1.2, PSA, 4 KB records
CONFIG_MBEDTLS_TLS_VERSION_1_3        =y
CONFIG_MBEDTLS_PSA_CRYPTO_C           =y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN    =4096
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED =y
CONFIG_MBEDTLS_HKDF_C                 =y
# the PSA algorithms TLS 1.3 / 1.2 with P-256 need (mbedtls check_config.h): ECDHE + ECDSA on P-256, AES-GCM, SHA-256,
# HKDF, HMAC, the TLS 1.2 PRF; nothing else
CONFIG_PSA_WANT_ALG_ECDH                       =y
CONFIG_PSA_WANT_ALG_ECDSA                      =y
CONFIG_PSA_WANT_ALG_DETERMINISTIC_ECDSA        =y
CONFIG_PSA_WANT_ALG_GCM                        =y
CONFIG_PSA_WANT_ALG_ECB_NO_PADDING             =y
CONFIG_PSA_WANT_ALG_HKDF                       =y
CONFIG_PSA_WANT_ALG_HKDF_EXTRACT               =y
CONFIG_PSA_WANT_ALG_HKDF_EXPAND                =y
CONFIG_PSA_WANT_ALG_HMAC                       =y
CONFIG_PSA_WANT_ALG_SHA_256                    =y
CONFIG_PSA_WANT_ALG_TLS12_PRF                  =y
CONFIG_PSA_WANT_ECC_SECP_R1_256                =y
CONFIG_PSA_WANT_KEY_TYPE_AES                   =y
CONFIG_PSA_WANT_KEY_TYPE_HMAC                  =y
CONFIG_PSA_WANT_KEY_TYPE_DERIVE                =y
CONFIG_PSA_WANT_KEY_TYPE_RAW_DATA              =y
CONFIG_PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY        =y
CONFIG_PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT   =y
CONFIG_PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT   =y
CONFIG_PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE =y
CONFIG_PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE   =y
# PSA key material on the heap while a key exists, not 16 static slots sized for the largest key enabled (RSA, from
# the Wi-Fi set's TLS 1.2 key exchanges): 38.4 KB of static RAM otherwise (the QUIC spike's finding, 2026-11-10)
CONFIG_MBEDTLS_PSA_STATIC_KEY_SLOTS =n

# mbedTLS trimmed to what the check-in's mTLS uses (user 2026-11-10: "trim mbedTLS"): ECDHE-ECDSA on P-256 with
# AES-GCM only. The Wi-Fi set's defaults pull in every TLS key exchange (RSA, DHE, PSK, ECDH), DES, DHM and prime
# generation: code for ciphersuites nothing here offers. wpa_supplicant's own needs (WPA2/3 personal: SHA-1, PBKDF2,
# MD5, AES, ECC) stay
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED       =n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_ENABLED       =n
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED   =n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED =n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED =n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED  =n
CONFIG_MBEDTLS_CIPHER_DES_ENABLED             =n
CONFIG_MBEDTLS_DHM_C                          =n
CONFIG_MBEDTLS_GENPRIME_ENABLED               =n
CONFIG_MBEDTLS_PK_WRITE_C                     =n
