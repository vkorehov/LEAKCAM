# LEAKCAM BL616: power manager, NetHub Wi-Fi bridge to the K230 (SDIO) and BLE provisioning,
# one image. Wi-Fi base: the SDK's examples/wifi/nethub, cut to what the bridge needs. Removed:
# the AT control module, low power (the BL616 hibernates between sessions instead), USB/dual
# profiles, IPv6 (the BL616 has no address of its own), ping, iperf, Ethernet PHY, TTY channel.
# The DHCP server stays: the Wi-Fi stack's lwIP adapter includes it unconditionally.

-include $(BL_SDK_BASE)/examples/wifi/defconfig

CONFIG_PING =n
CONFIG_IPV6 =n

# NetHub over SDIO; the control path is ours (wifi_ctrl_proto.h on the USER virtual channel)
CONFIG_NETHUB                          =y
CONFIG_NETHUB_PROFILE_SDIO             =y
CONFIG_NETHUB_PROFILE_USB              =n
CONFIG_NETHUB_PROFILE_DUAL             =n
CONFIG_NETHUB_CTRLCHANNEL_USE_ATMODULE =n
CONFIG_NETHUB_LOWPOWER_ENABLE          =n

# message router: SDIO device driver, netdev and virtual-channel services.
# SDIO ports per direction: the K230 driver counts the same number (BL616_PORTS = 4)
CONFIG_BSP_MR              =y
CONFIG_MR_SDIO_DRIVER      =y
CONFIG_MR_SDIO_QUEUE_DEPTH =4
CONFIG_MR_NETDEV           =y
CONFIG_MR_VIRTUALCHAN      =y
CONFIG_MR_TTY              =n

# BLE on USB power, only to store the Wi-Fi SSID and passphrase: peripheral role, no BLE shell
# commands. Wi-Fi and BLE run together as in the SDK's examples/wifi/coex/wifi_ble.
CONFIG_BLUETOOTH              =y
CONFIG_BTBLECONTROLLER_LIB    =ble1m0s1bredr0
CONFIG_BT_STACK_CLI           =n

# BLE bonds and the Wi-Fi credentials live in easyflash on littlefs
CONFIG_LITTLEFS              =y
CONFIG_LITTLEFS_KV_EASYFLASH =y
CONFIG_BFLB_MTD              =y
CONFIG_PARTITION             =y

# console on USB CDC (PR1), so UART0 on GPIO21/22 is free for the K230 link and boot logs
# never drive into the K230's unpowered 3V3 rail. The console option depends on CherryUSB's
# CDC-ACM device class on FreeRTOS and on the SDK shell: without these it is dropped silently and
# the console stays on UART0.
CONFIG_CHERRYUSB                =y
CONFIG_CHERRYUSB_OSAL           ="freertos"
CONFIG_CHERRYUSB_DEVICE         =y
CONFIG_CHERRYUSB_DEVICE_CDC     =y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM =y
CONFIG_BSP_CONSOLE_USB_CDC      =y
CONFIG_PM                       =y
