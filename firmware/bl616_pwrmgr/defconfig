# console on USB CDC (PR1), so UART0 on GPIO21/22 is free for the K230 link and boot logs
# never drive into the K230's unpowered 3V3 rail. The console option depends on CherryUSB's
# CDC-ACM device class on FreeRTOS and on the SDK shell: without these it is dropped silently and
# the console stays on UART0.
CONFIG_SHELL=y
CONFIG_CHERRYUSB=y
CONFIG_CHERRYUSB_OSAL="freertos"
CONFIG_CHERRYUSB_DEVICE=y
CONFIG_CHERRYUSB_DEVICE_CDC=y
CONFIG_CHERRYUSB_DEVICE_CDC_ACM=y
CONFIG_BSP_CONSOLE_USB_CDC=y
CONFIG_PM=y

# USB-powered mode: FreeRTOS + BLE for Wi-Fi credential setup (as examples/btble/peripheral)
CONFIG_FREERTOS=y
CONFIG_BLUETOOTH=y
CONFIG_RF=y
CONFIG_BTBLECONTROLLER_LIB=ble1m0s1bredr0
# no BLE shell commands (they need the SDK shell, which the power manager does not run)
CONFIG_BT_STACK_CLI=n
# BLE bonds and the Wi-Fi credentials are kept in easyflash on littlefs
CONFIG_BFLB_MTD=y
CONFIG_PARTITION=y
CONFIG_LITTLEFS=y
