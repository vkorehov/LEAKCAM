-        if (!f[i].changed)
-            continue;
-        struct hist_info hi;
-        const uint8_t (*blocks)[IMGDIFF_BLOCKS_X] = f[i].have_view
-            ? (const uint8_t (*)[IMGDIFF_BLOCKS_X])f[i].diff.block_changed : NULL;
