+/* TEMPORARY (test015, SDK copy only; install.sh restores this file): SDIO download speed.
+ * bl616_bench [frames] [bytes]: frames through the real netdev path (ring, credits, ports), timed from the
+ * first queued to the ring empty; bus-only = the CMD53 writes alone. bl616_clk <hz> sets the SDIO clock. */
+extern volatile rt_uint64_t bl616_bench_bus_cycles, bl616_bench_bus_bytes, bl616_bench_busy, bl616_bench_rx_bytes, bl616_bench_rx_cycles;
+extern void bl616_sdio_bus_info(rt_uint32_t *clk, rt_uint32_t *width, rt_uint32_t *hs);
+extern void bl616_sdio_set_clock(rt_uint32_t hz);
+extern void bl616_sdio_dump(const char *why);
+static rt_uint64_t bench_time(void) { rt_uint64_t t; __asm__ volatile("rdtime %0" : "=r"(t)); return t; }
+static rt_uint8_t bench_frame[1514];
+
+static int bl616_bench(int argc, char **argv)
+{
+    int n = argc > 1 ? atoi(argv[1]) : 1000, size = argc > 2 ? atoi(argv[2]) : 1514, i, full = 0;
+    rt_uint32_t clk, width, hs;
+    rt_uint64_t t0, t1;
+    rt_err_t e = RT_EOK;
+
+    if (size < 60 || size > 1514)
+        size = 1514;
+    int raw = bench_raw || netdev.state != CH_RUN;     /* no DEVICE_START: the bare echo device (pt_sdu); open it ourselves */
+    if (raw)
+    {
+        bench_raw = 1;
+        netdev.state = CH_RUN;
+        netdev.sent = 0;
+        netdev.credit = 100;
+    }
+    rt_memset(bench_frame, 0xa5, sizeof(bench_frame));
+    rt_memcpy(bench_frame, "\x02\x00\x00\x00\x00\x01\x02\x00\x00\x00\x00\x02\x88\xb5", 14);
+    bl616_bench_bus_cycles = bl616_bench_bus_bytes = bl616_bench_busy = bl616_bench_rx_bytes = bl616_bench_rx_cycles = 0;
+    t0 = bench_time();
+    for (i = 0; i < n; i++)
+    {
+        rt_uint64_t tq = bench_time();
+        while ((e = bl616_link_send_frame(bench_frame, size)) == -RT_EFULL)
+        {
+            full++;
+            if (raw)
+                netdev.credit = (rt_uint8_t)(netdev.sent + 100);
+            if (bench_time() - tq > 3u * 27000000u)
+                break;
+            rt_thread_mdelay(1);            /* sleep, not yield: the watchdog feeder (prio 25) must run */
+        }
+        if (e == -RT_EFULL)
+        {
+            rt_kprintf("bl616_bench: STALL queueing frame %d (ring %u, sent %u, credit %u)\n", i,
+                       (unsigned)netdev.ring.count, (unsigned)netdev.sent, (unsigned)netdev.credit);
+            bl616_sdio_dump("queue stall");
+            break;
+        }
+        if (raw)
+            netdev.credit = (rt_uint8_t)(netdev.sent + 100);
+        if (e != RT_EOK)
+            break;
+    }
+    {
+        rt_uint64_t td = bench_time();
+        while (netdev.ring.count)
+        {
+            if (raw)
+                netdev.credit = (rt_uint8_t)(netdev.sent + 100);
+            if (bench_time() - td > 3u * 27000000u)
+            {
+                rt_kprintf("bl616_bench: STALL draining (ring %u, sent %u, credit %u)\n",
+                           (unsigned)netdev.ring.count, (unsigned)netdev.sent, (unsigned)netdev.credit);
+                bl616_sdio_dump("drain stall");
+                break;
+            }
+            rt_thread_mdelay(1);
+        }
+    }
+    t1 = bench_time();
+    {   /* the echoes: wait until as much came back as went out, 2 s at most */
+        rt_uint64_t tw = bench_time();
+        while (bl616_bench_rx_bytes < bl616_bench_bus_bytes && bench_time() - tw < 2u * 27000000u)
+            rt_thread_mdelay(1);
+        rt_uint64_t t2 = bench_time(), us2 = (t2 - t0) / 27, rx_us = bl616_bench_rx_cycles / 27;
+        rt_kprintf("bl616_bench: echoes back %u KB of %u KB, %u ms after the start: %u KB/s round trip; reads %u KB/s on the bus\n",
+                   (unsigned)(bl616_bench_rx_bytes / 1024), (unsigned)(bl616_bench_bus_bytes / 1024), (unsigned)(us2 / 1000),
+                   (unsigned)(us2 ? bl616_bench_rx_bytes * 1000000 / 1024 / us2 : 0),
+                   (unsigned)(rx_us ? bl616_bench_rx_bytes * 1000000 / 1024 / rx_us : 0));
+    }
+    bl616_sdio_bus_info(&clk, &width, &hs);
+    {
+        rt_uint64_t us = (t1 - t0) / 27, bus_us = bl616_bench_bus_cycles / 27, bytes = (rt_uint64_t)i * size;
+        rt_kprintf("bl616_bench: %d frames x %d B in %u ms: %u KB/s end to end; bus %u KB in %u ms: %u KB/s;"
+                   " BL616 busy %u, ring full %d; clock %u Hz, %u-bit, high speed %u%s\n",
+                   i, size, (unsigned)(us / 1000), (unsigned)(us ? bytes * 1000000 / 1024 / us : 0),
+                   (unsigned)(bl616_bench_bus_bytes / 1024), (unsigned)(bus_us / 1000),
+                   (unsigned)(bus_us ? bl616_bench_bus_bytes * 1000000 / 1024 / bus_us : 0),
+                   (unsigned)bl616_bench_busy, full, (unsigned)clk, (unsigned)width, (unsigned)hs,
+                   e != RT_EOK ? " (stopped on an error)" : "");
+    }
+    return 0;
+}
+MSH_CMD_EXPORT(bl616_bench, test015: SDIO download speed [frames] [bytes]);
+
+static int bl616_clk(int argc, char **argv)
+{
+    rt_uint32_t clk, width, hs;
+    if (argc > 1)
+        bl616_sdio_set_clock((rt_uint32_t)atoi(argv[1]));
+    bl616_sdio_bus_info(&clk, &width, &hs);
+    rt_kprintf("bl616_clk: %u Hz, %u-bit, high speed %u\n", (unsigned)clk, (unsigned)width, (unsigned)hs);
+    return 0;
+}
+MSH_CMD_EXPORT(bl616_clk, test015: show or set the SDIO clock [hz]);
+
+static int bl616_dump(int argc, char **argv) { (void)argc; (void)argv; bl616_sdio_dump("shell"); return 0; }
+MSH_CMD_EXPORT(bl616_dump, test015: SDIO port state);
